# Zoo Test Contracts Environment Variables
# Copy to .env and populate from KMS: kms.hanzo.ai

# Get from KMS: kms.hanzo.ai/zoo/contracts/deployer-private-key
PRIVATE_KEY=<from-kms>
# Get from KMS: kms.hanzo.ai/zoo/contracts/rpc-url
RPC_URL=<from-kms>
# Get from KMS: kms.hanzo.ai/zoo/contracts/etherscan-api-key
ETHERSCAN_API_KEY=<from-kms>
