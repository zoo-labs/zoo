# Where Blue's answers come from.
#
# Unset, the sites call api.zoo.cloud — the proxy in zoo/cloud that holds the
# tenant credential, because api.hanzo.ai sends no CORS headers and refuses
# anonymous callers, and a static site cannot hold a key.
#
# Point it at a machine you are running instead to work offline:
#
#   llama-server -m zen-eco-4b-agent-Q4_K_M.gguf --port 8081 --host 0.0.0.0
#   NEXT_PUBLIC_ZOO_API=http://localhost:8081 pnpm dev
#
NEXT_PUBLIC_ZOO_API=https://api.zoo.cloud
NEXT_PUBLIC_ZOO_MODEL=zen-free
