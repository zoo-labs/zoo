{
  "name": "@zoolabs/foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/counts.mjs && node scripts/gui-css.mjs && next dev",
    "build": "node scripts/counts.mjs && node scripts/gui-css.mjs && next build",
    "export": "node scripts/counts.mjs && node scripts/gui-css.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && yarn format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "node scripts/counts.mjs && tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "postbuild": "next-sitemap --config next-sitemap.config.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@fontsource/poppins": "^5.0.8",
    "@google/model-viewer": "^3.4.0",
    "@hanzo/appearance": "^0.2.5",
    "@hanzo/design": "^0.5.25",
    "@hanzo/font": "^1.9.3",
    "@hanzo/gui": "^8.3.2",
    "@hanzo/ui": "^8.27.8",
    "@hanzogui/animations-css": "8.3.2",
    "@hanzogui/config": "8.3.2",
    "@hanzogui/telemetry": "8.3.3",
    "@hanzogui/web": "8.3.2",
    "@mui/material": "^7.0.2",
    "@ramonak/react-progress-bar": "^5.3.0",
    "@react-native/assets-registry": "^0.86.2",
    "@stripe/react-stripe-js": "^2.5.1",
    "@stripe/stripe-js": "^3.0.8",
    "@types/cookie": "^0.6.0",
    "@types/react-slick": "^0.23.13",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.456.0",
    "next": "^15.3.0",
    "react": "^19.2.8",
    "react-card-flip": "^1.2.2",
    "react-dom": "^19.2.8",
    "react-globe.gl": "^2.27.2",
    "react-icons": "^5.2.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-slick": "^0.30.2",
    "react-switch": "^7.1.0",
    "react-toastify": "^10.0.5",
    "slick-carousel": "^1.8.1",
    "stripe": "^14.20.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.24.4",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^20.11.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "next-router-mock": "^0.9.12",
    "next-sitemap": "^4.2.3",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.36",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  }
}
